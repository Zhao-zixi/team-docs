{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "sourceMap": true
  },
  "include": [
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "src/mcp/**/*.ts"
  ]
}
